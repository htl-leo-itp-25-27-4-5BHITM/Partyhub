GET {{baseUrl}}/1/followers/count

?? status == 401

### Anonymous profile access is rejected: /1/following/count
GET {{baseUrl}}/1/following/count

?? status == 401

### Anonymous profile access is rejected: /1/followers
GET {{baseUrl}}/1/followers

?? status == 401

### Anonymous profile access is rejected: /1/following
GET {{baseUrl}}/1/following

?? status == 401

### Anonymous profile access is rejected: /4/follow-requests
GET {{baseUrl}}/4/follow-requests

?? status == 401

