@host = http://localhost:8080
@baseUrl = {{host}}/api/users
@anna = 1
@michael = 2
@sabine = 5

###########################################
### Seed: get all users from import.sql
###########################################
GET {{baseUrl}}
X-User-Id: 1

?? status == 200


###########################################
### Search users by distinct name
###########################################
GET {{baseUrl}}?q=anna
X-User-Id: 1

?? status == 200


###########################################
### Get user by ID
###########################################
GET {{baseUrl}}/{{anna}}
X-User-Id: 1

?? status == 200


###########################################
### Get current user by query param
###########################################
GET {{baseUrl}}/me?userId={{anna}}
X-User-Id: {{anna}}

?? status == 200


###########################################
### Current user needs query param
###########################################
GET {{baseUrl}}/me
X-User-Id: {{anna}}

?? status == 200


###########################################
### Follower count for Anna
###########################################
GET {{baseUrl}}/{{anna}}/followers/count
X-User-Id: 1

?? status == 200


###########################################
### Following count for Anna
###########################################
GET {{baseUrl}}/{{anna}}/following/count
X-User-Id: 1

?? status == 200


###########################################
### Followers of Anna
###########################################
GET {{baseUrl}}/{{anna}}/followers
X-User-Id: 1

?? status == 200


###########################################
### Following of Anna
###########################################
GET {{baseUrl}}/{{anna}}/following
X-User-Id: 1

?? status == 200


###########################################
### Pending follow requests for Thomas
###########################################
GET {{baseUrl}}/4/follow-requests
X-User-Id: 4

?? status == 200


###########################################
### Follow status: Anna follows Michael in import.sql
###########################################
GET {{baseUrl}}/{{anna}}/followers/{{michael}}/status
X-User-Id: 1

?? status == 200


###########################################
### Stored user locations are not exposed (spec: device location stays client-side)
###########################################
GET {{baseUrl}}/location/{{anna}}
X-User-Id: {{anna}}

?? status == 404


###########################################
### Profile picture binary/default image
###########################################
GET {{baseUrl}}/{{anna}}/profile-picture

?? status == 200


###########################################
### Profile picture filename
###########################################
GET {{baseUrl}}/{{anna}}/profile-picture-filename

?? status == 200


###########################################
### User media
###########################################
GET {{baseUrl}}/{{anna}}/media
X-User-Id: 2

?? status == 200

### Anonymous profile access is rejected: list
GET {{baseUrl}}

?? status == 401

### Anonymous profile access is rejected: /1
GET {{baseUrl}}/1

?? status == 401

### Anonymous profile access is rejected: /handle/anna
GET {{baseUrl}}/handle/anna

?? status == 401

### Anonymous profile access is rejected: /username/anna
GET {{baseUrl}}/username/anna

?? status == 401

### Anonymous profile access is rejected: /me
GET {{baseUrl}}/me

?? status == 401

### Anonymous profile access is rejected: /1/followers/count
GET {{baseUrl}}/1/followers/count

?? status == 401

### Anonymous profile access is rejected: /1/following/count
GET {{baseUrl}}/1/following/count

?? status == 401

### Anonymous profile access is rejected: /1/followers
GET {{baseUrl}}/1/followers

?? status == 401

### Anonymous profile access is rejected: /1/following
GET {{baseUrl}}/1/following

?? status == 401

### Anonymous profile access is rejected: /4/follow-requests
GET {{baseUrl}}/4/follow-requests

?? status == 401

### Anonymous profile access is rejected: /1/followers/2/status
GET {{baseUrl}}/1/followers/2/status

?? status == 401

###
### Profile update: the e-mail is not changed here (only through /api/me/email-change)
###
PUT {{baseUrl}}/3
X-User-Id: 3
Content-Type: application/json

{ "displayName": "Katrin Bauer", "distinctName": "katrin_bauer", "email": "changed@example.test", "biography": "Hi" }

?? status == 200
?? body email == katrin.bauer@partyhub.at

###
### Profile update: a new handle must follow the rules
###
PUT {{baseUrl}}/3
X-User-Id: 3
Content-Type: application/json

{ "displayName": "Katrin Bauer", "distinctName": "no spaces allowed", "biography": "Hi" }

?? status == 400
?? body field == distinctName

###
### Hosted parties of the own profile
###
GET {{baseUrl}}/3/parties
X-User-Id: 3

?? status == 200
