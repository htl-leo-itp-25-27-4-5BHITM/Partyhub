@host = http://localhost:8080
@baseUrl = {{host}}/api/users

###
### Seed: follower count for Anna
###
GET {{baseUrl}}/1/followers/count
X-User-Id: 1

?? status == 200


###
### Seed: following count for Anna
###
GET {{baseUrl}}/1/following/count
X-User-Id: 1

?? status == 200


###
### Seed: followers of Anna
###
GET {{baseUrl}}/1/followers
X-User-Id: 1

?? status == 200


###
### Seed: Anna follows Michael and Katrin
###
GET {{baseUrl}}/1/following
X-User-Id: 1

?? status == 200


###
### Seed: Michael sees his own pending follow request from Carla
###
GET {{baseUrl}}/4/follow-requests
X-User-Id: 4

?? status == 200
?? js response.parsedBody.some(u => u.distinctName === 'carla_dimmler') == true
?? js response.parsedBody[0].requestedAt != null


###
### Other users cannot read Michael's pending follow requests
###
GET {{baseUrl}}/4/follow-requests
X-User-Id: 1

?? status == 403


###
### Carla sees her own request to Michael as pending
###
GET {{baseUrl}}/4/follow-status
X-User-Id: 2

?? status == 200
?? body status == pending


###
### Anna (1) follows Michael? no relationship
###
GET {{baseUrl}}/4/follow-status
X-User-Id: 1

?? status == 200
?? body status == none


###
### Seed: Anna follows Michael
###
GET {{baseUrl}}/1/followers/2/status
X-User-Id: 1

?? status == 200


###
### Send follow request: Lukas wants to follow Nina
###
POST {{baseUrl}}/6/follow?targetUserId=9
X-User-Id: 6

?? status == 201



###
### Follow targetUserId is required
###
POST {{baseUrl}}/6/follow
X-User-Id: 6

?? status == 400
