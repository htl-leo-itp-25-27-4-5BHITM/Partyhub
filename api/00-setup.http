@host = http://localhost:8080
@usersUrl = {{host}}/api/users
@partiesUrl = {{host}}/api/parties

###########################################
### CI fixtures are loaded by the dev seed, never created through a public account API.
###########################################
GET {{usersUrl}}/1
X-User-Id: 1

?? status == 200

GET {{usersUrl}}/2
X-User-Id: 1

?? status == 200

GET {{usersUrl}}/3
X-User-Id: 1

?? status == 200

GET {{usersUrl}}/4
X-User-Id: 1

?? status == 200

GET {{usersUrl}}/5
X-User-Id: 1

?? status == 200

GET {{usersUrl}}/6
X-User-Id: 1

?? status == 200

GET {{usersUrl}}/7
X-User-Id: 1

?? status == 200

GET {{usersUrl}}/8
X-User-Id: 1

?? status == 200

GET {{usersUrl}}/9
X-User-Id: 1

?? status == 200

GET {{usersUrl}}/10
X-User-Id: 1

?? status == 200

###########################################
### Locations are not stored on the server (spec: device location stays client-side)
###########################################
PUT {{usersUrl}}/location
X-User-Id: 1
Content-Type: application/json

{
  "latitude": 48.268335,
  "longitude": 14.251920
}

?? js response.statusCode == 404 || response.statusCode == 405

###########################################
### CI setup: create parties expected by smoke tests
###########################################
POST {{partiesUrl}}
X-User-Id: 1
Content-Type: application/json

{
  "title": "Afterwork Test",
  "description": "Afterwork party for HTTPYac smoke tests",
  "fee": 0,
  "time_start": "2026-05-26T18:30:00",
  "time_end": "2026-05-26T23:30:00",
  "max_people": 80,
  "min_age": 18,
  "max_age": 45,
  "website": "https://partyhub.local/afterwork",
  "latitude": 48.3065,
  "longitude": 14.2850,
  "location_address": "Hauptplatz Linz",
  "theme": "Afterwork",
  "visibility": "PUBLIC",
  "selectedUsers": []
}

?? status == 201

