@host = http://localhost:8080
@baseUrl = {{host}}/api/notifications

###########################################
### Seed: notifications for Michael
###########################################
GET {{baseUrl}}
X-User-Id: 2

?? status == 200


###########################################
### Seed: unread notifications for Michael
###########################################
GET {{baseUrl}}/unread
X-User-Id: 2

?? status == 200


###########################################
### Missing user currently returns an empty list
###########################################
GET {{baseUrl}}

?? status == 401


###########################################
### Mark Michael's invitation notification as read
###########################################
POST {{baseUrl}}/1/read
X-User-Id: 2

?? status == 200


###########################################
### Unread count for Michael
###########################################
GET {{baseUrl}}/unread/count
X-User-Id: 2

?? status == 200


###########################################
### Mark all of Michael's notifications as read
###########################################
POST {{baseUrl}}/read-all
X-User-Id: 2

?? status == 200


###########################################
### Mark all as read requires a user
###########################################
POST {{baseUrl}}/read-all

?? status == 401


###########################################
### Other users cannot mark Michael's notification
###########################################
POST {{baseUrl}}/1/read
X-User-Id: 1

?? status == 403


###########################################
### Other users cannot delete Michael's notification
###########################################
DELETE {{baseUrl}}/1
X-User-Id: 1

?? status == 403


###########################################
### Delete unknown notification
###########################################
DELETE {{baseUrl}}/99999
X-User-Id: 2

?? status == 404

###
### Notification settings: own state with master switch and categories
###
GET {{host}}/api/me/notification-settings
X-User-Id: 1

?? status == 200
?? body allEnabled == true

###
### Notification settings: master off keeps the categories
###
PUT {{host}}/api/me/notification-settings
X-User-Id: 1
Content-Type: application/json

{ "allEnabled": false }

?? status == 200
?? body allEnabled == false
?? body partyUpdates == true

###
### Notification settings: master on again
###
PUT {{host}}/api/me/notification-settings
X-User-Id: 1
Content-Type: application/json

{ "allEnabled": true }

?? status == 200
?? body allEnabled == true
